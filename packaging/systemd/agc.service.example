[Unit]
Description=Agent Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/absolute/path/to/bin:/usr/local/bin:/usr/bin
ExecStart=/absolute/path/to/agc run /absolute/path/to/config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
